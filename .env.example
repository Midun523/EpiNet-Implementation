# ─── MySQL / Docker ───────────────────────────────
MYSQL_ROOT_PASSWORD=root_pass
MYSQL_DATABASE=epinet
MYSQL_USER=epinet
MYSQL_PASSWORD=epinet_pass

# ─── Spring Boot datasource (matches docker-compose) ─
DB_URL=jdbc:mysql://localhost:3306/epinet?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=epinet
DB_PASS=epinet_pass

# ─── ML service URL (default: local) ──────────────
ML_SERVICE_URL=http://localhost:8000

# ─── Frontend API base URL ─────────────────────────
VITE_API_URL=http://localhost:8080
